{
	"name": "cyrus-router-client",
	"version": "0.2.66",
	"description": "Device-side WebSocket client for the Cyrus Router: dial, reconnect, RPC, acks, and durable offline buffer/inbox",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cyrusagents/cyrus.git",
		"directory": "packages/router-client"
	},
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsgo",
		"dev": "tsgo --watch",
		"test": "vitest",
		"test:run": "vitest run",
		"typecheck": "tsgo --noEmit"
	},
	"dependencies": {
		"cyrus-core": "workspace:*",
		"cyrus-linear-event-transport": "workspace:*",
		"cyrus-otel-traces": "workspace:*",
		"cyrus-router-protocol": "workspace:*",
		"ws": "^8.21.1"
	},
	"devDependencies": {
		"@types/node": "^20.19.43",
		"@types/ws": "^8.18.1",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"vitest": "^4.1.10"
	},
	"publishConfig": {
		"access": "public"
	}
}
