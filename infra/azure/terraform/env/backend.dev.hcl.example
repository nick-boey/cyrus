################################################################################
# backend.dev.hcl.example — copy to backend.dev.hcl and fill in.
# NEVER commit backend.dev.hcl (.gitignore: `backend*.hcl`).
#
#   terraform init -backend-config=env/backend.dev.hcl
#
# These are IDENTIFIERS, not credentials. The backend authenticates with the
# ambient Azure credential (`az login` locally, the federated OIDC token in CI)
# because of `use_azuread_auth` below — no storage account key is involved and
# none should ever be placed in this file.
#
# Every value here is printed by scripts/bootstrap-tfstate.sh when it finishes.
################################################################################

# The state resource group. Deliberately NOT `rg-<project>-<environment>`: that
# name is generated by the stack itself (main.tf:10) and is destroyed by
# `terraform destroy`. State must outlive the stack it describes.
resource_group_name = "rg-cyrus-tfstate"

# 3-24 chars, lowercase alphanumeric only, globally unique across Azure.
storage_account_name = "<state-storage-account>"

container_name = "tfstate"

# One key per environment in the SAME container — this is what keeps dev and
# prod state separate. Changing it silently starts an EMPTY state, so treat a
# plan that proposes creating everything from scratch as a wrong key, not as
# drift.
key = "dev.tfstate"

# Authenticate to the blob endpoint with AAD/RBAC rather than a shared account
# key. Matches `rbac_authorization_enabled = true` on the vault, and is what
# lets the CI identity reach state with no stored secret.
use_azuread_auth = true
