################################################################################
# dev.tfvars.example — copy to dev.tfvars and fill in. NEVER commit dev.tfvars.
# Every variable is documented in variables.tf; this file lists each one with a
# sample/placeholder so a fresh operator has a complete checklist.
################################################################################

# ---- Project / naming -------------------------------------------------------
project     = "cyrus"
environment = "dev"
# resource_group_name = "rg-cyrus" # Optional exact override.
tags = {
  owner       = "platform"
  cost-center = "research"
}

# ---- Location (spike S7: 35 regions supported; australiaeast verified) ------
location = "australiaeast"

# ---- Container images --------------------------------------------------------
# BOTH image refs MUST be immutable: a digest (`@sha256:<64 hex>`), a release tag
# (`v1.2.3`), or a git-SHA tag (`sha-a1b2c3d`). Terraform REJECTS mutable tags
# (`:latest`, `:deploy`, branch or ad-hoc hotfix tags) — a floating tag means the
# next `terraform apply` can silently redeploy a DIFFERENT (possibly older) build
# while reporting no change, because the tag string in state never moved. See
# README → "Router image tag policy" for the build/push/pin runbook.
#
# Both placeholders below are deliberately SHAPE-VALID but fake, so the step-3
# bootstrap apply (which targets only Key Vault / identities / ACR / sandbox
# group, and creates no Container App) passes variable validation. Replace them
# with real refs in step 4, BEFORE the step-5 full apply.
#
# router_image: pulled by the Container App directly. Public GHCR works
# anonymously. Private registries require `enable_acr = true` AND `az acr
# import` (or a direct `buildx --push`) of the image into the ACR (see README).
router_image = "ghcr.io/ceedaragents/cyrus-router:sha-0000000"

# router_url_for_containers: WSS URL containers dial back to. The router's real
# FQDN is only known AFTER first apply (can't be embedded in the router's own
# env without a Terraform dependency cycle). TWO-APPLY FLOW:
#   1. Leave null on first apply (router boots; containers won't connect yet).
#   2. `terraform output router_wss_url` → paste the value here.
#   3. `terraform apply` again.
router_url_for_containers = null

# worker_image: NOT pulled by the router. Register it as a group disk image
# OUT OF BAND after first apply:
#   aca sandboxgroup disk create --image <worker_image> --name <aca_disk_name> \
#     --resource-group <rg> --sandbox-group <sandbox_group_name>
# Immutable here too — the disk image is registered out of band, so a floating
# tag leaves no way to tell which build a registered disk was cut from.
worker_image = "ghcr.io/ceedaragents/cyrus-worker:sha-0000000"

# allow_mutable_image_tags: ESCAPE HATCH, leave false. Setting it true re-permits
# `:latest`/`:deploy`/branch tags above and forfeits the guarantee that an apply
# redeploys the build you tested. Throwaway stacks only.
allow_mutable_image_tags = false

# aca_disk_name: the disk image NAME the group knows the worker image by. Must
# match the `--name` you passed to `aca sandboxgroup disk create` above.
aca_disk_name = "cyrus-worker"

# ---- ACA per-sandbox compute defaults ----------------------------------------
# These are PASSED TO THE ROUTER CONFIG (CYRUS_ROUTER_CONTAINERS_JSON), NOT to
# the ARM sandboxGroups resource — spike finding: the ARM resource accepts
# `properties: {}` only. See README → "maxSandboxCount does not exist".
aca_cpu    = "4000m" # XL tier; most expensive — set consciously.
aca_memory = "8192Mi"

# 0 = DISABLED (spike N5/F2: ACA-side suspend has no session-affinity gate and
# can freeze a live session mid-task). The router's idleStopMs is the sole idle
# controller. Leave this at 0.
aca_auto_suspend_seconds = 0

# Deny-by-default egress (D7). The router injects the full D7 allowlist on each
# sandbox create. 'Allow' disables the wall for air-gap-free test sandboxes.
aca_egress_default_action      = "Deny"
aca_egress_traffic_inspection = "Full"
# Leave null to retain the provider's complete built-in allowlist and append the
# router WSS host. Setting a list replaces that default entirely.
aca_egress_host_rules = null

# Retention for explicit per-issue labeled snapshots the provider prunes on the
# create path. Snapshots are NEVER GC'd by Azure — keep this modest.
aca_keep_snapshots = 2

# ---- Linear secrets (seeded into Key Vault; rotate after first deploy) ------
# Real organization UUID from `cyrus self-auth-linear`; do not use the slug.
linear_workspace_id = "00000000-0000-0000-0000-000000000000"

# All five below are SENSITIVE — pull from your password manager, NOT from git.
linear_workspace_token         = "<linear-workspace-api-token>"
linear_workspace_refresh_token = "<linear-workspace-refresh-token>"
# HMAC secret — generate with `openssl rand -hex 32` and paste the SAME value
# into Linear's webhook subscription UI (see README → Linear webhook cutover).
linear_webhook_secret  = "<openssl-rand-hex-32>"
linear_client_id       = "<linear-oauth-client-id>"
linear_client_secret  = "<linear-oauth-client-secret>"

# ---- RBAC fallback -----------------------------------------------------------
# Optional — when null, the stack resolves "Container Apps SandboxGroup Data
# Owner" via a `data.azurerm_role_definition` lookup by name. Spike S6 verified
# the documented GUID resolves in-tenant; set this only if the lookup fails.
sandboxgroup_data_owner_role_id = null

# Operator break-glass principal (Entra object id). Without this, an operator
# cannot delete a corrupt router.db blob (M2). Set null in pure-CI envs.
operator_principal_id = null

# ---- Cyrus repositories ------------------------------------------------------
# Routed by the router. Becomes `CYRUS_ROUTER_CONTAINERS_JSON.repositories`.
cyrus_repositories = [
  {
    name                = "cyrus-containers"
    github_slug         = "ceedaragents/cyrus-containers"
    linear_workspace_id = "00000000-0000-0000-0000-000000000000"
    base_branch         = "main"
  },
]

# ---- Optional feature flags --------------------------------------------------
enable_acr         = false # see README for the `az acr import` recipe.
enable_custom_domain = false
custom_domain_name             = null
custom_domain_certificate_zone_id = null

# Set tenant + audience together to enable Entra-gated enrollment. The audience
# is the app registration's exact Application ID URI (for example api://...).
entra_tenant_id     = null
entra_audience      = null
entra_allowed_domain = null

# ---- Setup management UI (/setup) — STAGED, see README §11 -------------------
# TWO SEPARATE APPLIES with a live verification gate between them. `authConfigs`
# is a child of the Container App, so a single flag would necessarily publish the
# revision serving /setup BEFORE the auth sidecar exists. Terraform refuses
# `enable_setup_ui` unless `enable_setup_auth` AND `setup_auth_stage1_verified`
# are already true, so you cannot collapse the stages by editing this file once.
#
#   Apply 1: enable_setup_auth = true   (routes still 404)
#   GATE:    README §11 step 5 — machine routes, header-strip probe, sign-in
#   Apply 2: enable_setup_ui   = true   (routes exist)
# Rollback reverses the order.
enable_setup_auth = false
enable_setup_ui   = false

# Required when enable_setup_auth = true. Reuse the EXISTING router app
# registration — one app registration/audience per router deployment.
setup_ui_client_id     = null # bare client-id GUID, e.g. "00000000-0000-0000-0000-000000000000"
setup_ui_client_secret = null # SENSITIVE — `az ad app credential reset`, shown once

# Required when enable_setup_auth = true. Static RFC 3339 window for the ACA
# token-store SAS. Do NOT derive from timestamp(): that re-evaluates on every
# plan and rolls a new router revision each apply. EXPIRY IS A LIVE FAILURE
# DEADLINE — past it, sign-in breaks. Diarise the renewal.
setup_ui_token_store_sas_start  = null # "2026-01-01T00:00:00Z"
setup_ui_token_store_sas_expiry = null # "2027-01-01T00:00:00Z"

# ATTESTATION, not a switch. Set true only after applying stage 1 ALONE and
# passing README §11 step 5a/5b/5c against the live app. Gates enable_setup_ui.
setup_auth_stage1_verified = false

# 'entra-token' (default, recommended) verifies the forwarded ID token
# cryptographically and ignores X-MS-CLIENT-PRINCIPAL-* entirely.
# 'easyauth-headers' trusts the injected headers and additionally requires
# setup_ui_verified_header_strip = true, recorded from the step-5b probe.
setup_ui_auth_mode             = "entra-token"
setup_ui_verified_header_strip = false
setup_ui_id_token_audience     = null # defaults to setup_ui_client_id; NOT the api:// URI

# Optional in-router domain allowlist. Defence in depth only — it cannot tell an
# assigned teammate from any other account in the same tenant.
setup_ui_allowed_domain = null # "example.com"

# Auto-provisioning is OFF by default. Terraform refuses to enable it without a
# membership gate: populate an allowedPrincipals list below, or run the Entra
# assignment commands in README §11 step 3 and attest to them.
setup_ui_auto_provision_users         = false
setup_ui_allowed_group_object_ids     = []
setup_ui_allowed_principal_object_ids = []
setup_ui_assignment_required_verified = false

# ---- Per-user secret storage backend (create-once infra; see README) ---------
# The Azure Table, the envelope-encryption KEK, and the router's Storage Table
# Data Contributor + Key Vault Crypto User roles are created by EVERY apply and
# have no enable flag — they are create-once and persistent, and both the Table
# and the KEK carry prevent_destroy. The flag below is the ONLY reversible
# control: it adds/removes `containers.tableStore` in the rendered router
# config. Enable it only AFTER `cyrus router secrets migrate` has run.
enable_setup_table_backend = false

# Provider inherited by users whose stored executor is the explicit
# {"type":"default"} sentinel. A NULL/absent executor still means "physical
# device" and is never captured by this, so nobody silently moves to ACA.
router_default_executor = "aca"
