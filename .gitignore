.edge-config.json

CLAUDE.local.md

# Claude Code harness runtime artifacts
.claude/scheduled_tasks.lock

docker/router/.env

# Bicep parameter files. These hold the Linear client secret and both OAuth
# tokens in plaintext, exactly as the Terraform tfvars they replace did. Only the
# committed `.example` checklist is tracked.
*.bicepparam
!*.bicepparam.example
# scripts/deploy-router-image.sh stages its rewrite in a mode-600 temp file
# beside main.bicepparam. `*.bicepparam` above does not match a name with a
# suffix after `.bicepparam`, and BSD mktemp only substitutes a TRAILING run of
# X's, so the temp name cannot both be unique and end in `.bicepparam`. Ignore
# the prefix instead: a SIGKILL mid-rewrite leaves behind the client secret and
# both OAuth tokens.
*.bicepparam.tmp.*
# Compiled ARM output. `bicep build` writes <name>.json beside the template by
# default; it embeds nothing secret, but it is a build artifact and a committed
# copy immediately goes stale against the .bicep it came from.
infra/azure/bicep/**/*.json

# Claude worktrees
.claude/worktrees
.superpowers/
