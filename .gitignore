.DS_Store
Thumbs.db
workspaces

**/.claude/settings.local.json

.env.secret-agents

# Edge config
.edge-config.json

CLAUDE.local.md

# Claude Code harness runtime artifacts
.claude/scheduled_tasks.lock

docker/router/.env

# Bicep parameter files. Steady-state files are designed to be secretless, but
# the same path may temporarily hold bootstrap/rotation values when an explicit
# write flag is enabled. Only the committed `.example` checklist is tracked.
*.bicepparam
!*.bicepparam.example
# scripts/deploy-router-image.sh stages its rewrite in a mode-600 temp file
# beside main.bicepparam. `*.bicepparam` above does not match a name with a
# suffix after `.bicepparam`, and BSD mktemp only substitutes a TRAILING run of
# X's, so the temp name cannot both be unique and end in `.bicepparam`. Ignore
# the prefix instead: a SIGKILL during bootstrap/rotation may leave secrets in
# that copy.
*.bicepparam.tmp.*
# Compiled ARM output. `bicep build` writes <name>.json beside the template by
# default; it embeds nothing secret, but it is a build artifact and a committed
# copy immediately goes stale against the .bicep it came from.
infra/azure/bicep/**/*.json

# Claude worktrees
.claude/worktrees
.superpowers/

# NOR-309 spike reproduction build artifacts. `build.sh` stages a copy of the
# cyrus-worker Feature here (the devcontainer CLI refuses local feature paths
# that escape the .devcontainer folder) and the CLI writes a lock file beside
# it; neither is a source.
docker/worker/devcontainer/.devcontainer/features/cyrus-worker/
docker/worker/devcontainer/.devcontainer/devcontainer-lock.json

# Key-encryption keys must never be committed (0600 local KEK for sealed
# Codex credentials; a stray one appears if a router is pointed at a
# ":memory:" database, whose dirname is the CWD).
codex-kek.key
**/codex-kek.key
