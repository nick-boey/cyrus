# --- Required -----------------------------------------------------------
# Linear organization id (key under linearWorkspaces in ~/.cyrus/config.json
# after `cyrus self-auth-linear`).
LINEAR_WORKSPACE_ID=
# Workspace Linear token (linearWorkspaces.<id>.linearToken from the same file).
LINEAR_WORKSPACE_TOKEN=
# Webhook signing secret from the Linear OAuth app.
LINEAR_WEBHOOK_SECRET=

# --- Optional (defaults shown) -------------------------------------------
# CYRUS_ROUTER_PORT=8787
# CYRUS_ROUTER_HOST=0.0.0.0
# CYRUS_ROUTER_WEBHOOK_MODE=direct          # or "proxy" behind the Cyrus proxy
# CYRUS_ROUTER_EVENT_TTL_MS=172800000       # 48h queued-event TTL
# CYRUS_ROUTER_ISSUE_LOCK=true
# CYRUS_ROUTER_CREATOR_ONLY_PROMPTING=true
# CYRUS_ROUTER_HEARTBEAT_MS=30000
# Multi-workspace escape hatch (supersedes LINEAR_WORKSPACE_ID/_TOKEN):
# CYRUS_ROUTER_WORKSPACES_JSON={"<workspace-id>":{"linearToken":"..."}}

# --- Setup management UI (optional; off by default) ----------------------
# Lets a teammate manage their own container secrets at /setup instead of
# `cyrus router secrets set`. Requires CYRUS_ROUTER_CONTAINERS_JSON to also be
# set — the page edits the same per-user secret bundle containers boot from.
# CYRUS_ROUTER_SETUP_UI_ENABLED=false
# CYRUS_ROUTER_SETUP_UI_AUTH_MODE=entra-token       # or easyauth-headers, dev-insecure-headers
# CYRUS_ROUTER_SETUP_UI_ID_TOKEN_AUDIENCE=          # required if AUTH_MODE=entra-token; bare client-id GUID, not api://
# CYRUS_ROUTER_SETUP_UI_VERIFIED_HEADER_STRIP=true  # required (must be "true") if AUTH_MODE=easyauth-headers; set only after live header-strip verification
# CYRUS_ROUTER_SETUP_UI_ALLOWED_DOMAIN=             # optional email-domain allowlist, e.g. example.com
# CYRUS_ROUTER_SETUP_UI_AUTO_PROVISION=false        # true only once sign-in is already restricted to your team (see docs/ROUTER.md)

# --- cloudflared sidecar (only with: docker compose --profile tunnel up) --
# TUNNEL_TOKEN=
